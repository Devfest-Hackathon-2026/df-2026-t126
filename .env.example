# Explicitly offline. This file does not enable cloud access.
RUNTIME_MODE=local
ENABLE_CLOUD=false
AI_MODE=mock
SERVICE_ROLE=api
DEADLINE_GRACE_S=5
HEARTBEAT_INTERVAL_S=5
DROPOUT_AFTER_S=15
VIDEO_MAX_BYTES=10000000
TEXT_MAX_LENGTH=2000
JSON_MAX_BYTES=1000000
GESTURE_BATCH_MAX_BYTES=250000
# Successful room creation and round starts per 60 seconds. Set global
# limits after choosing capacity for the deployment (0 disables that scope).
ROOM_CREATE_UID_LIMIT=10
ROUND_START_UID_LIMIT=3
ROOM_CREATE_GLOBAL_LIMIT=0
ROUND_START_GLOBAL_LIMIT=0
CORS_ORIGINS=["http://localhost:5173"]
# Emulator-only overrides; explicitly export in your shell when needed.
# RUNTIME_MODE=emulator
# PROJECT_ID=demo-gesture-relay
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Cloud settings are deliberately absent. See infra/README.md.
