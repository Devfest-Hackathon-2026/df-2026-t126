# このファイルをコピーして .env.local を作る（.env.local は Git に入らない）
# mock: ブラウザ内の偽物のサーバーを使う / real: 本物の API と Firestore を使う
VITE_BACKEND=mock

# 本物の API の URL。Hosting の転送を使うときは空のままにする
VITE_API_BASE_URL=

# Firebase の Web 設定値（real のときに必要）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
