{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "node scripts/prepare-mediapipe.mjs",
    "prebuild": "node scripts/prepare-mediapipe.mjs",
    "dev:https": "node scripts/prepare-mediapipe.mjs && vite --mode https",
    "test": "node --test \"tests/**/*.test.ts\"",
    "dev:emulator": "node scripts/prepare-mediapipe.mjs && vite --mode emulator"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
